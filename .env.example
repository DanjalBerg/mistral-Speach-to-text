# Mistral API key for the hosted realtime endpoint (https://console.mistral.ai/api-keys)
# Not needed when pointing --url at a self-hosted vLLM /v1/realtime server.
MISTRAL_API_KEY=

# Optional overrides (all have CLI flags too)
# VOXTRAL_MODEL=voxtral-mini-transcribe-realtime-3
# VOXTRAL_WS_URL=wss://api.mistral.ai/v1/audio/transcriptions/realtime?model=voxtral-mini-transcribe-realtime-3
# VOXTRAL_DELAY_MS=480
# VOXTRAL_LANGUAGE=en
# VOXTRAL_CONTEXT_BIAS=Northwind,Quillara
# VOXTRAL_DIARIZE=false
# VOXTRAL_TURN_DETECTION=false
# VOXTRAL_DEVICE=
# VOXTRAL_SAMPLE_RATE=16000
# VOXTRAL_CHUNK_MS=100
# VOXTRAL_LINES=3
# VOXTRAL_FONT_SIZE=28
# VOXTRAL_LOG_FILE=
# VOXTRAL_NO_OVERLAY=false
